PORT=8182

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=gestion_deportiva_db
# Siempre false: las tablas se crean con migraciones (ACUERDOS.md, 6.15).
DB_SYNCHRONIZE=false

# Microservicio de seguridad (ms_security, Spring Boot). El SecurityGuard le pregunta por los permisos.
MS_SECURITY=http://localhost:8181
# false = el guard deja pasar todo (solo para probar en local sin ms_security).
SEGURIDAD_HABILITADA=true

# Origen del front (React + Vite).
CORS_ORIGIN=http://localhost:5173

# Microservicio de correo (ms-notifications). La clave es la misma de su .env. Nunca se sube.
MS_NOTIFICATIONS=http://localhost:5000
EMAIL_SERVICE_API_KEY=
# Destinatarios de prueba mientras no existan aficionados (entrega 3), separados por coma.
NOTIFICACIONES_CORREOS_PRUEBA=correo1@gmail.com,correo2@gmail.com
