{
  "info": {
    "_postman_id": "f1000000-2026-4e20-8000-000000000001",
    "name": "ms-gestion-deportiva — Colección Completa (Entrega 2 · 16 HU)",
    "description": "Colección unificada v2.1 ejecutable de principio a fin (A + B + C) con autenticación real en ms_security (:8181), pruebas de seguridad (401/403), happy path, validaciones 400 ({ campo: mensaje }), 404, 409 (ALREADY_EXISTS / HAS_ASSOCIATIONS), tabla de posiciones, llaves y desarrollo del torneo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "00 - Seguridad y Autenticación (ms_security)",
      "item": [
        {
          "name": "00.1 Login Administrador Deportivo (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = String(Date.now()).slice(-6);",
                  "pm.environment.set('runId', runId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK - Login exitoso', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.expect(data.accessToken).to.be.a('string').and.not.empty;",
                  "pm.environment.set('token', data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{securityBaseUrl}}/api/auth/login",
              "host": ["{{securityBaseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "00.2 Acceso sin token devuelve 401 UNAUTHORIZED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('errorCase UNAUTHORIZED', () => pm.expect(pm.response.json().errorCase).to.eql('UNAUTHORIZED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/deportes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "deportes"]
            },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "00.3 Verificar permisos deportivos en /api/auth/me (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const me = pm.response.json();",
                  "pm.test('Tiene rol ADMINISTRADOR DEPORTIVO', () => pm.expect(me.roles).to.include('ADMINISTRADOR DEPORTIVO'));",
                  "pm.test('Tiene los 79 permisos deportivos', () => pm.expect(me.permissions.length).to.be.at.least(79));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{securityBaseUrl}}/api/auth/me",
              "host": ["{{securityBaseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
