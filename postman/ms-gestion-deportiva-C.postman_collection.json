        {
          "name": "6. Listar habilidades de un jugador (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Devuelve arreglo con la habilidad asignada', function () {",
                  "  const list = pm.response.json();",
                  "  pm.expect(list).to.be.an('array');",
                  "  const esperada = Number(pm.environment.get('habilidadAsignadaId') || pm.environment.get('habilidadId'));",
                  "  const encontrada = list.find((h) => h.id === esperada);",
                  "  pm.expect(encontrada).to.not.be.undefined;",
                  "  pm.expect(encontrada).to.have.all.keys('id', 'nombre', 'categoria');",
                  "});"
                ]
