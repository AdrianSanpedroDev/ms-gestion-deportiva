              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Devuelve arreglo de JugadorResumen con el jugador asignado', function () {",
                  "  const list = pm.response.json();",
                  "  pm.expect(list).to.be.an('array');",
                  "  const esperado = Number(pm.environment.get('jugadorId'));",
                  "  const encontrado = list.find((j) => j.id === esperado);",
                  "  pm.expect(encontrado).to.not.be.undefined;",
                  "  pm.expect(encontrado).to.have.all.keys('id', 'tipoDocumento', 'numeroDocumento', 'nombreCompleto', 'activo');",
                  "});"
