    {
      "name": "HU-GD-07 - Asignar habilidades a jugadores",
      "description": "ACUERDOS 9.12: POST /api/jugadores/{jugadorId}/habilidades, GET /api/jugadores/{jugadorId}/habilidades, GET /api/habilidades/{habilidadId}/jugadores, DELETE /api/jugadores/{jugadorId}/habilidades/{habilidadId}",
      "item": [
        {
          "name": "1. Asignar habilidad a jugador (Happy Path - 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Respuesta cumple contrato HabilidadResumen', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.all.keys('id', 'nombre', 'categoria');",
                  "  pm.expect(body.id).to.eql(Number(pm.environment.get('habilidadId')));",
                  "  pm.environment.set('habilidadAsignadaId', String(body.id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"habilidadId\": {{habilidadId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/jugadores/{{jugadorId}}/habilidades",
              "host": ["{{baseUrl}}"],
              "path": ["api", "jugadores", "{{jugadorId}}", "habilidades"]
            }
